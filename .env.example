PORT=19900

# 数据目录：空则自动探测 %APPDATA% 下 TRAE SOLO CN / Trae 等
TRAE_DATA_DIR=

# cn | sg（SOLO 国内版用 cn）
TRAE_EDITION=cn

# solo = TRAE SOLO（推荐，排队轻）；trae = 经典 Trae（chat_v3 排队重）
TRAE_PRODUCT=solo

TRAE_API_HOST=https://trae-api-cn.mchost.guru
TRAE_AUTH_HOST=https://trae-api-cn.mchost.guru
TRAE_MANUAL_TOKEN=
API_KEY=trae-solo-local-api-key
WORKSPACE_DIR=./output
LOG_LEVEL=info
OUTPUT_SYNC_DIR=

# SOLO 指定模型 function（默认 solo_work_lite，避免 chat_v3 重排队）
# TRAE_SOLO_FUNCTION=solo_work_lite
# TRAE_AUTO_FUNCTION=inline_chat
# TRAE_WORK_MODE=work

# 自动续写：只有思考无正文 / 半截输出时服务端再请求一轮（OpenAI+Anthropic）
AUTO_CONTINUE=true
MAX_CONTINUES=10

# TRAE_IDE_VERSION=
# TRAE_IDE_VERSION_CODE=
# TRAE_INSTALL_DIR=
# TRAE_DEVICE_ID=
# TRAE_MACHINE_ID=
# TRAE_APP_ID=6eefa01c-1036-4c7e-9ca5-d891f63bfcd8

# SOLO OAuth（product.json SOLO.stable）
# TRAE_OAUTH_CLIENT_ID=en1oxy7wnw8j9n
# TRAE_OAUTH_CLIENT_SECRET=-
# TRAE_DEVICE_MODEL=83DG
# TRAE_OS_VERSION=Windows 11 Pro

# HTTP_PROXY=
# HTTPS_PROXY=
# ALL_PROXY=
